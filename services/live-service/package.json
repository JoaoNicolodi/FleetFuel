{
  "name": "@fleetfuel/live-service",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço B (Live/Sessão/Tempo Real): sessões efêmeras, telemetria e WebSocket do painel",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:core-purity": "node ../../scripts/check-core-purity.mjs src/core"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "amqplib": "^0.10.4",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
